<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>netstandard2.0;net10.0</TargetFrameworks>
		<Nullable>enable</Nullable>
		<PackageId>ListFunctions.Engine</PackageId>
		<AssemblyName>ListFunctions.Engine</AssemblyName>
	</PropertyGroup>

	<PropertyGroup Condition=" '$(TargetFramework)' == 'netstandard2.0' ">
		<AssemblyTitle>ListFunctions.Engine - .NET Standard 2.0</AssemblyTitle>
		<Product>ListFunctions.Engine - .NET Standard 2.0</Product>
	</PropertyGroup>
	<PropertyGroup Condition=" '$(TargetFramework)' == 'net6.0' ">
		<AssemblyTitle>ListFunctions.Engine - .NET 6</AssemblyTitle>
		<Product>ListFunctions.Engine - .NET 6</Product>
	</PropertyGroup>
	<PropertyGroup Condition=" '$(TargetFramework)' == 'net8.0' ">
		<AssemblyTitle>ListFunctions.Engine - .NET 8</AssemblyTitle>
		<Product>ListFunctions.Engine - .NET 8</Product>
	</PropertyGroup>
	<PropertyGroup Condition=" '$(TargetFramework)' == 'net9.0' ">
		<AssemblyTitle>ListFunctions.Engine - .NET 9</AssemblyTitle>
		<Product>ListFunctions.Engine - .NET 9</Product>
	</PropertyGroup>
	<PropertyGroup Condition=" '$(TargetFramework)' == 'net10.0' ">
		<AssemblyTitle>ListFunctions.Engine - .NET 10</AssemblyTitle>
		<Product>ListFunctions.Engine - .NET 10</Product>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)'=='Debug'">
		<DebugType>full</DebugType>
		<DebugSymbols>true</DebugSymbols>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)'=='Release'">
		<DebugType>portable</DebugType>
	</PropertyGroup>

	<ItemGroup>
		<AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
			<_Parameter1>ListFunctions.Next</_Parameter1>
		</AssemblyAttribute>
	</ItemGroup>
	<ItemGroup>
		<AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
			<_Parameter1>ListFunctions.NETFramework</_Parameter1>
		</AssemblyAttribute>
	</ItemGroup>
	<ItemGroup>
		<AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
			<_Parameter1>ListFunctions.Engine.Tests</_Parameter1>
		</AssemblyAttribute>
	</ItemGroup>

	<ItemGroup Condition="'$(Configuration)'=='Debug'">
		<Content Include="Debug.ps1">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
	</ItemGroup>

	<ItemGroup>
		<Compile Remove="Internal\VarList.cs" />
	</ItemGroup>

	<ItemGroup>
		<None Include="Internal\VarList.cs" />
	</ItemGroup>

	<ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
		<PackageReference Include="PowerShellStandard.Library" PrivateAssets="all" ExcludeAssets="runtime" />
		<PackageReference Include="Microsoft.Bcl.Memory" />
		<PackageReference Include="System.Collections.Immutable" />
		<PackageReference Include="System.Runtime.CompilerServices.Unsafe" />
		<PackageReference Include="System.Memory" />
	</ItemGroup>
	<ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
		<PackageReference Include="System.Management.Automation" ExcludeAssets="runtime;native" />
	</ItemGroup>
	<ItemGroup>
		<PackageReference Include="ZLinq" />
		<PackageReference Include="PolySharp">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
	</ItemGroup>

</Project>
