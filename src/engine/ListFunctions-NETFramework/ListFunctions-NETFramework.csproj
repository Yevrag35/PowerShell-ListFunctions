<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net48</TargetFramework>
		<LangVersion>latest</LangVersion>
		<Nullable>enable</Nullable>
		<ImplicitUsings>disable</ImplicitUsings>
		<RootNamespace>ListFunctions</RootNamespace>
		<AssemblyName>ListFunctions.NETFramework</AssemblyName>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<Authors>Mike Garvey</Authors>
		<Company>Yevrag35, LLC.</Company>
		<Copyright>Copyright © Yevrag35, LLC. 2020-2025</Copyright>
		<Product>ListFunctions-NETFramework</Product>
		<AssemblyTitle>ListFunctions-NETFramework</AssemblyTitle>
		<Version>3.1.0</Version>
		<AssemblyVersion>3.1.0</AssemblyVersion>
		<FileVersion>3.1.0</FileVersion>
		<ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)'=='Debug'">
		<DebugType>full</DebugType>
		<DebugSymbols>true</DebugSymbols>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)'=='Release'">
		<DebugType>portable</DebugType>
	</PropertyGroup>

	<ItemGroup Condition="'$(Configuration)' != 'Release'">
		<Content Include="Debug.ps1">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
	</ItemGroup>
	<ItemGroup Condition="'$(Configuration)' == 'Release'">
		<Content Include="Debug.ps1">
			<CopyToOutputDirectory>Never</CopyToOutputDirectory>
			<CopyToPublishDirectory>Never</CopyToPublishDirectory>
		</Content>
	</ItemGroup>

	<!-- Every cmdlet source file is shared with the PowerShell 7 project. -->
	<ItemGroup>
		<Compile Include="..\ListFunctions-Next\**\*.cs" Exclude="..\ListFunctions-Next\obj\**;..\ListFunctions-Next\bin\**" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.PowerShell.5.ReferenceAssemblies" ExcludeAssets="runtime" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\ListFunctions.Engine\ListFunctions.Engine.csproj" />
	</ItemGroup>

</Project>
