<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>disable</Nullable>
		<Product>ListFunctions</Product>
		<Description>A PowerShell module that provides functions to manipulate and search through Arrays, Collections, Lists, and Sets.</Description>
		<AssemblyName>ListFunctions.Next</AssemblyName>
		<PackageIconUrl>https://github.com/Yevrag35/PowerShell-ListFunctions/blob/master/.icon/list-functions.png?raw=true</PackageIconUrl>
		<PackageLicenseUrl>https://raw.githubusercontent.com/Yevrag35/PowerShell-ListFunctions/master/LICENSE</PackageLicenseUrl>
		<SupportUrl>https://github.com/Yevrag35/PowerShell-ListFunctions/issues</SupportUrl>
		<GenerateDocumentationFile>True</GenerateDocumentationFile>
	</PropertyGroup>

	<ItemGroup Condition="'$(Configuration)' != 'Release'">
		<Content Include="Debug.ps1">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</Content>
	</ItemGroup>
	<ItemGroup Condition="'$(Configuration)' == 'Release'">
		<Content Include="Debug.ps1">
			<CopyToOutputDirectory>Never</CopyToOutputDirectory>
			<CopyToPublishDirectory>Never</CopyToPublishDirectory>
		</Content>
	</ItemGroup>

	<!-- Get-Help reads the cmdlets' help from a culture folder beside the assembly, in a file named after the assembly. -->
	<ItemGroup>
		<Content Include="en-US\ListFunctions.Next.dll-Help.xml">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="System.Management.Automation" ExcludeAssets="runtime;native" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\ListFunctions.Engine\ListFunctions.Engine.csproj" />
	</ItemGroup>

</Project>
