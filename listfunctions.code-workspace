{
	"folders": [
		{
			"path": ".",
			"name": "ListFunctions"
		}
	],
	"settings": {
		"terminal.explorerKind": "integrated",
		"powershell.powerShellDefaultVersion": "PowerShell (x64)",
		"powershell.debugging.createTemporaryIntegratedConsole": false,
		"powershell.enableProfileLoading": false
	},
	"tasks": {
		"version": "2.0.0",
		"tasks": [
			{
				"label": "Build",
				"detail": "Builds every project in the solution in Debug, which the Test task runs against.",
				"type": "process",
				"command": "dotnet",
				"args": [
					"build",
					"${workspaceFolder:ListFunctions}\\src\\engine\\ListFunctions.Engine.slnx",
					"-c",
					"Debug"
				],
				"options": {
					"cwd": "${workspaceFolder:ListFunctions}"
				},
				"problemMatcher": "$msCompile",
				"promptOnClose": true,
				"presentation": {
					"echo": true,
					"reveal": "silent",
					"focus": false,
					"panel": "shared",
					"showReuseMessage": false,
					"clear": false
				},
				"group": {
					"kind": "build",
					"isDefault": true
				}
			},
			{
				"label": "Test",
				"detail": "Runs the Pester tests against the Debug build in Windows PowerShell 5.1 and stable PowerShell 7. Doesn't build first.",
				"type": "process",
				"command": "${env:ProgramFiles}\\PowerShell\\7\\pwsh.exe",
				"args": [
					"-NoProfile",
					"-ExecutionPolicy",
					"Bypass",
					"-File",
					"${workspaceFolder:ListFunctions}\\tests\\Invoke-Tests.ps1"
				],
				"options": {
					"cwd": "${workspaceFolder:ListFunctions}",
					"env": {
						"Path": "${env:ProgramFiles}\\PowerShell\\7;${env:Path}"
					}
				},
				"problemMatcher": [],
				"presentation": {
					"echo": true,
					"reveal": "always",
					"focus": false,
					"panel": "dedicated",
					"showReuseMessage": false,
					"clear": true
				},
				"group": {
					"kind": "test",
					"isDefault": true
				}
			}
		]
	}
}